    "check:publish-ready": "node scripts/check-content-publish-ready.mjs",
    "check:buyer-flow": "node scripts/check-buyer-flow.mjs",
    "validate:content": "node scripts/validate-content-data.mjs",
    "seo:crawler": "node scripts/generate-crawler-files.mjs",
    "export:sheets": "node scripts/export-content-sheets.mjs",
