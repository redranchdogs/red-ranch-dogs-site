    "leads:packet": "node scripts/generate-lead-workflow-packet.mjs",
    "leads:uat": "node scripts/run-lead-uat-scenarios.mjs",
    "leads:uat:write": "node scripts/run-lead-uat-scenarios.mjs --write",
    "test:forms": "node scripts/test-form-api-handler.mjs",
    "test:forms:webhook": "node scripts/test-form-webhook.mjs",
    "test:forms:live-notification": "node scripts/run-live-form-notification-recheck.mjs",
    "ops:workflow": "node scripts/generate-weekly-workflow.mjs",
    "photos:packet": "node scripts/generate-photo-workflow-packet.mjs",
    "ops:handoff": "node scripts/generate-session-handoff.mjs",
    "ops:full": "npm run leads:rebuild-queue && npm run leads:packet && npm run ops:workflow && npm run photos:plan && npm run ops:status && npm run review:visual && npm run review:seo && npm run review:deploy && npm run review:sheets && npm run launch:decision && npm run launch:signoff && npm run ops:handoff",
    "ops:status": "node scripts/run-operations-pass.mjs",
    "launch:decision": "node scripts/generate-launch-decision.mjs",
    "launch:signoff": "node scripts/generate-prelaunch-signoff.mjs",
    "launch:check": "node scripts/launch-readiness-check.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "drive:media-folders": "node scripts/plan-drive-folders.mjs --media-only",
    "drive:media-folders:write": "node scripts/plan-drive-folders.mjs --media-only --write"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "playwright": "^1.60.0"
  }
}
