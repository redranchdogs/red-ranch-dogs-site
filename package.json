{
  "name": "red-ranch-dogs-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/clean-dist.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "check:source": "node scripts/check-source-of-truth.mjs",
    "check:source-of-truth": "node scripts/check-source-of-truth.mjs",
    "check:buyer-flow": "node scripts/check-buyer-flow.mjs",
    "validate:content": "node scripts/validate-content-data.mjs",
    "export:sheets": "node scripts/export-content-sheets.mjs",
    "sync:sheets": "node scripts/sync-content-sheets-smart.mjs",
    "sync:sheets:dry-run": "node scripts/sync-content-sheets-smart.mjs --dry-run",
    "sync:puppies": "node scripts/sync-content-sheets-smart.mjs --only=\"Puppy Tracker\"",
    "sync:puppies:dry-run": "node scripts/sync-content-sheets-smart.mjs --dry-run --only=\"Puppy Tracker\"",
    "sync:litters": "node scripts/sync-content-sheets-smart.mjs --only=Litters",
    "sync:litters:dry-run": "node scripts/sync-content-sheets-smart.mjs --dry-run --only=Litters",
    "sync:previous-litters": "node scripts/sync-content-sheets-smart.mjs --only=\"Previous Litters\"",
    "sync:previous-litters:dry-run": "node scripts/sync-content-sheets-smart.mjs --dry-run --only=\"Previous Litters\"",
    "sync:parents": "node scripts/sync-content-sheets-smart.mjs --only=\"Parent Dogs\"",
    "sync:parents:dry-run": "node scripts/sync-content-sheets-smart.mjs --dry-run --only=\"Parent Dogs\"",
    "sync:waitlist": "node scripts/sync-content-sheets-smart.mjs --only=\"Public Waitlist\"",
    "sync:waitlist:dry-run": "node scripts/sync-content-sheets-smart.mjs --dry-run --only=\"Public Waitlist\"",
    "review:business": "node scripts/audit-business-accuracy.mjs",
    "review:pages": "node scripts/generate-page-review-packet.mjs",
    "review:images": "node scripts/audit-image-assets.mjs",
    "review:safety": "node scripts/audit-public-safety.mjs",
    "review:visual": "node scripts/audit-visual-routes.mjs",
    "review:seo": "node scripts/audit-seo-metadata.mjs",
    "review:deploy": "node scripts/audit-deploy-package.mjs",
    "review:sheets": "node scripts/audit-sheet-sync.mjs",
    "review:launch": "npm run review:business && npm run review:pages && npm run review:images && npm run review:safety",
    "audit:business": "npm run review:business",
    "audit:pages": "npm run review:pages",
    "audit:images": "npm run review:images",
    "audit:launch": "npm run review:launch",
    "drive:folders": "node scripts/plan-drive-folders.mjs",
    "drive:folders:write": "node scripts/plan-drive-folders.mjs --write",
    "photos:plan": "npm run drive:folders && npm run photos:packet",
    "bridge:status": "node scripts/test-bridge-auth.mjs",
    "test:bridge": "node scripts/test-bridge-auth.mjs",
    "bridge:delete-sheet": "node scripts/delete-sheet-tab.mjs",
    "bridge:setup-submissions": "node scripts/setup-website-submissions-workbook.mjs",
    "leads:rebuild-queue": "node scripts/rebuild-lead-queue.mjs",
    "leads:packet": "node scripts/generate-lead-workflow-packet.mjs",
    "leads:uat": "node scripts/run-lead-uat-scenarios.mjs",
    "leads:uat:write": "node scripts/run-lead-uat-scenarios.mjs --write",
    "test:forms": "node scripts/test-form-api-handler.mjs",
    "test:forms:webhook": "node scripts/test-form-webhook.mjs",
    "ops:workflow": "node scripts/generate-weekly-workflow.mjs",
    "photos:packet": "node scripts/generate-photo-workflow-packet.mjs",
    "ops:handoff": "node scripts/generate-session-handoff.mjs",
    "ops:full": "npm run leads:rebuild-queue && npm run leads:packet && npm run ops:workflow && npm run photos:plan && npm run ops:status && npm run review:visual && npm run review:seo && npm run review:deploy && npm run review:sheets && npm run launch:decision && npm run launch:signoff && npm run ops:handoff",
    "ops:status": "node scripts/run-operations-pass.mjs",
    "launch:decision": "node scripts/generate-launch-decision.mjs",
    "launch:signoff": "node scripts/generate-prelaunch-signoff.mjs",
    "launch:check": "node scripts/launch-readiness-check.mjs",
    "verify:routes": "node scripts/verify-routes.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "playwright": "^1.60.0"
  }
}
