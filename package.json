    "sync:previous-litters": "node scripts/sync-content-sheets-smart.mjs --only=\"Previous Litters\"",
    "sync:previous-litters:dry-run": "node scripts/sync-content-sheets-smart.mjs --dry-run --only=\"Previous Litters\"",
    "sync:parents": "node scripts/sync-content-sheets-smart.mjs --only=\"Parent Dogs\"",
    "sync:parents:dry-run": "node scripts/sync-content-sheets-smart.mjs --dry-run --only=\"Parent Dogs\"",
    "sync:waitlist": "node scripts/sync-content-sheets-smart.mjs --only=\"Public Waitlist\"",
    "sync:waitlist:dry-run": "node scripts/sync-content-sheets-smart.mjs --dry-run --only=\"Public Waitlist\"",
    "review:business": "node scripts/audit-business-accuracy.mjs",
    "review:pages": "node scripts/generate-page-review-packet.mjs",
    "review:images": "node scripts/audit-image-assets.mjs",
    "review:safety": "node scripts/audit-public-safety.mjs",
    "review:visual": "node scripts/audit-visual-routes.mjs",
    "review:seo": "node scripts/audit-seo-metadata.mjs",
    "review:deploy": "node scripts/audit-deploy-package.mjs",
    "review:sheets": "node scripts/audit-sheet-sync.mjs",
